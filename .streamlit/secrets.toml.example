# ============================================================
#  .streamlit/secrets.toml.example — SAFE TO COMMIT
#  Copy to .streamlit/secrets.toml and fill real values.
#  The actual secrets.toml is in .gitignore.
# ============================================================

# When deploying to Streamlit Cloud, add these under:
# App Settings → Secrets → paste the contents of secrets.toml

[general]
SECRET_KEY = "replace_with_64_char_random_string"
APP_ENV    = "production"

[model]
MODEL_PATH = "models/best_model.pth"
